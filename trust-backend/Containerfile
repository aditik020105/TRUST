# Containerfile for TRUST High-Security Digital Evidence Backend
FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm install

# Copy source, policies, and config
COPY tsconfig.json ./
COPY policies ./policies
COPY src ./src

ENV NODE_ENV=production
ENV PORT=3001
ENV DATA_DIR=/app/data
ENV STORAGE_DIR=/app/storage

# Build TypeScript to JavaScript
RUN npm run build

# Volume mount points for isolated persistent state
RUN mkdir -p /app/data /app/storage

EXPOSE 3001

CMD ["node", "dist/index.js"]
