{
  "name": "trust-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "bench": "ts-node scripts/benchmark.ts",
    "backup": "ts-node scripts/backup.ts",
    "seed:demo": "ts-node scripts/seed-demo.ts",
    "admin:restore": "ts-node scripts/restore-admin.ts",
    "gen:secrets": "node -e \"const c=require('crypto');console.log('JWT_SECRET='+c.randomBytes(48).toString('base64url'));console.log('EVIDENCE_ENCRYPTION_KEY='+c.randomBytes(32).toString('hex'));console.log('REPORT_SIGNING_KEY='+Buffer.from(c.generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'})).toString('base64'));console.log('CASE_MGMT_WEBHOOK_SECRET='+c.randomBytes(32).toString('hex'))\"",
    "opa:parity": "ts-node scripts/opa-parity.ts",
    "fabric:check": "ts-node scripts/fabric-check.ts",
    "fabric:dump": "ts-node scripts/fabric-dump.ts",
    "ddos:simulate": "ts-node scripts/simulate-ddos.ts",
    "restore": "ts-node scripts/restore.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "setupFiles": [
      "<rootDir>/src/tests/support/setup-env.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/support/"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest",
      "^.+/node_modules/@noble/.+\\.js$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true,
            "module": "commonjs"
          },
          "isolatedModules": true
        }
      ]
    },
    "transformIgnorePatterns": [
      "^(?!.*/node_modules/@noble/).*/node_modules/"
    ],
    "testTimeout": 30000
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@hyperledger/fabric-gateway": "^1.13.0",
    "@supabase/supabase-js": "^2.100.0",
    "axios": "^1.14.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.15.0",
    "redis": "^4.7.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}