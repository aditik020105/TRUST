# Copy to trust-backend/.env and fill in. Never commit .env.
# Generate JWT_SECRET and EVIDENCE_ENCRYPTION_KEY with:  npm run gen:secrets

PORT=3001
NODE_ENV=development
# Comma-separated dashboard origins allowed by CORS (default: http://localhost:3000)
CORS_ORIGINS=http://localhost:3000

# --- Session tokens --------------------------------------------------------
# Long random string. Required when NODE_ENV=production.
JWT_SECRET=
# How long a session lasts before the user must sign the challenge again (max 1440)
SESSION_TTL_MINUTES=60

# --- Evidence encryption (AES-256-GCM) -------------------------------------
# 64 hex chars (32 bytes). Required in production. LOSING THIS KEY MAKES EVERY STORED FILE UNREADABLE.
# Keep a copy outside the server (password manager / KMS). Without it in development, a key is
# generated in data/encryption.key.
EVIDENCE_ENCRYPTION_KEY=

# --- Supabase (database + file storage) ------------------------------------
# Leave blank to use the local file emulator (data/db.json + storage/).
# Dashboard -> Project Settings -> API: "Project URL" and the "service_role" secret key.
# Then run supabase/schema.sql once in the SQL editor.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=evidence-files

# --- First administrator ---------------------------------------------------
# The first person to register with one of these emails becomes an approved admin
# (only while no approved admin exists). Everyone else starts pending.
ADMIN_EMAILS=

# --- Firebase (optional second factor) -------------------------------------
# When set, sign-up and sign-in also require a valid Firebase ID token for that email.
# Must match NEXT_PUBLIC_FIREBASE_PROJECT_ID in the dashboard.
FIREBASE_PROJECT_ID=
# Optional: service-account JSON (one line) to also reject revoked Firebase sessions
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Ledger ----------------------------------------------------------------
# local  = hash-chained append-only file (data/ledger.json); same contract rules as the chaincode
# fabric = Hyperledger Fabric via the Gateway API
LEDGER_MODE=local
# Multi-organisation network (recommended): the file printed by fabric/multi-org/start-network.sh.
# Each action is submitted as the acting user's agency; the FABRIC_* single-org settings below are then ignored.
FABRIC_ORGS_FILE=
# Single-organisation network (fabric/native or fabric-samples test network):
FABRIC_CHANNEL=evidence-channel
FABRIC_CHAINCODE=evidence-contract
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
FABRIC_TLS_CERT_PATH=
FABRIC_CERT_PATH=
FABRIC_KEY_PATH=

# --- Case access and delegation -------------------------------------------
# restricted (default): investigators/analysts see only cases they opened or were delegated to;
#   judiciary, auditors and admins see all. open: every approved role sees every case.
CASE_ACCESS_MODE=restricted
MAX_DELEGATION_HOURS=720
# Local ledger only: organisations allowed to read private case notes (Fabric uses collections_config.json)
PRIVATE_DATA_MEMBERS=PoliceOrgMSP,JudiciaryOrgMSP,AdminOrgMSP

# --- Lost-key recovery -----------------------------------------------------
# Distinct administrators who must approve a key rotation (capped by how many other admins exist)
RECOVERY_APPROVALS=2
RECOVERY_TTL_HOURS=72

# --- Courtroom reports -----------------------------------------------------
# Ed25519 private key (PKCS#8 PEM, base64-encoded) that signs report hashes. Required in production;
# in development one is generated in data/report-signing-key.pem.
#   node -e "const c=require('crypto');console.log(Buffer.from(c.generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'})).toString('base64'))"
REPORT_SIGNING_KEY=

# --- Case-management connector ---------------------------------------------
# Every custody event is POSTed here (JSON, X-Trust-Signature: sha256=<HMAC of body>), retried with backoff.
CASE_MGMT_WEBHOOK_URL=
CASE_MGMT_WEBHOOK_SECRET=

# --- Policy engine ---------------------------------------------------------
# Optional external OPA server running policies/trust_authz.rego; falls back to the embedded evaluator.
OPA_URL=

# --- Firewall --------------------------------------------------------------
# Redis shares the rate-limit counters, jails and logs across every backend instance. Blank = in memory.
REDIS_URL=
# Defaults: 30 requests / 10 s, jail above 50 for 30 s, DID revoked after 3 jails.
# Raise for many users behind one IP. Set TRUST_PROXY=true only behind a reverse proxy you control.
FIREWALL_MAX_REQUESTS=30
FIREWALL_BAN_THRESHOLD=50
FIREWALL_STRIKES=3
TRUST_PROXY=false

# --- Misc ------------------------------------------------------------------
MAX_UPLOAD_MB=50
REQUEST_TIMEOUT_MS=15000
# DB-vs-ledger reconciliation schedule (cron) or "off"
RECONCILE_CRON=*/10 * * * *
# Public URL to self-ping on free hosting (Render); leave blank locally
SELF_URL=
DATA_DIR=
STORAGE_DIR=
