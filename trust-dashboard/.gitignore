# trust-dashboard .gitignore

# Dependencies
node_modules/
/.pnp
.pnp.*

# Build outputs
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Environment and secrets
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local
!*.env.example
!.env.example

# Keys & Certificates
*.pem
*.key
*.trustkey.json
public/demo-keys/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & Vercel
.DS_Store
.vercel
